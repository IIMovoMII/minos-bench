# Never commit real credentials. The Windows UI stores Key and Base URL in a
# current-user DPAPI profile outside the repository. This file is only a manual
# cross-platform example.
#
# NAME uses LiteLLM provider/model format:
#   openai/model-id     -> OpenAI-compatible /v1/responses
#   anthropic/model-id  -> Anthropic /v1/messages through LiteLLM Responses
MODEL_A_NAME=provider/model-a
MODEL_A_API_KEY=
MODEL_A_BASE_URL=
MODEL_A_API_MODE=responses
MODEL_A_REASONING_EFFORT=default

MODEL_B_NAME=provider/model-b
MODEL_B_API_KEY=
MODEL_B_BASE_URL=
MODEL_B_API_MODE=responses
MODEL_B_REASONING_EFFORT=default

WEAK_MODEL_NAME=provider/weaker-model
WEAK_MODEL_API_KEY=
WEAK_MODEL_BASE_URL=
WEAK_MODEL_API_MODE=responses
WEAK_MODEL_REASONING_EFFORT=default

JUDGE_MODEL_NAME=provider/judge-model
JUDGE_MODEL_API_KEY=
JUDGE_MODEL_BASE_URL=
JUDGE_MODEL_API_MODE=responses
JUDGE_MODEL_REASONING_EFFORT=default
